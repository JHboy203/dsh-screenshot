# 临时复现脚本（`dev/_xxx.mjs` 用完即弃；沙箱里删不掉时至少别入库）
dev/_*

# Python 字节码（texreplay.py 会 import py/stitch.py，跑一次就生成）
__pycache__/
*.pyc

# 运行时产物（不入库）
node_modules/
.cache/
.dsh-diag/
out/
report/
dist/
build/
coverage/
*.log
*.bak-*

# 根目录散落的截图/录制产物（自检与手测留痕，不是源码）
/*.png
/*.jpg
/*.mp4

.DS_Store
Thumbs.db

# 敏感文件（红线：绝不入库）
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx
*.jks
.npmrc
.netrc
configs/*-secret.json
configs/*-config.json
